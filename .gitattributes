# Gleam template - Git attributes
# https://git-scm.com/docs/gitattributes

# Linguist: lock files are generated
flake.lock linguist-generated=true
manifest.toml linguist-generated=true

# Gleam source files (Erlang-targeted functional language)
*.gleam text diff=gleam linguist-language=Gleam
*.erl text diff=erlang linguist-language=Erlang

# Normalize line endings to LF and auto-detect text files
* text=auto eol=lf

# Shell scripts must use LF
*.sh text eol=lf
*.bash text eol=lf

# Windows batch files require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Do not normalize patch/diff files
*.diff -text
*.patch -text
